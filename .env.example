# Copy to .env.local and fill in. Any OpenAI-compatible /chat/completions
# backend works; switching backends is configuration only.

# --- Hosted (default): OpenRouter -------------------------------------------
LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemma-4-26b-a4b-it   # default
# LLM_BASE_URL=https://openrouter.ai/api/v1   # default

# --- Local: Ollama / vLLM (no key needed) -----------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4:26b

# Set to false if your backend rejects response_format: json_schema.
# LLM_STRUCTURED_OUTPUTS=true

# The older OPENROUTER_API_KEY / OPENROUTER_MODEL / OPENROUTER_BASE_URL names
# are still read as fallbacks.
